# Serenity staging environment example
# Copy to .env.staging.local only for staging checks. Do not put real secrets in this example.
# Do not use production Firebase, production Vercel, or real recipient email settings.

# Firebase web config
FB_CREDENTIAL=staging-firebase-web-api-key-placeholder
FB_AUTH_DOMAIN=serenity-staging.firebaseapp.com
FB_PROJECT=serenity-staging-project-id
FB_BUCKET=serenity-staging.appspot.com
FB_SENDER=staging-sender-id
FB_APP=staging-app-id

# App URL / public base URL
NEXT_PUBLIC_SITE_URL=https://serenity-staging-example.vercel.app

# Firebase admin/server config
FIREBASE_ADMIN_PROJECT_ID=serenity-staging-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-staging@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSTAGING_PRIVATE_KEY_PLACEHOLDER\n-----END PRIVATE KEY-----\n"
DAILY_IP_SALT=staging-random-salt-placeholder
CERTIFICATE_MEDIA_HOSTS=serenity-staging-example.vercel.app

# Vercel Blob / storage config
BLOB_READ_WRITE_TOKEN=vercel-blob-staging-token-placeholder

# Email provider / test mode
SEND_IN_BLUE_API_KEY=brevo-staging-or-sandbox-key-placeholder
BREVO_SENDER_EMAIL=staging-sender@example.com
EMAIL_SENDER_NAME=Serenity Staging

# Email and feature limits
DAILY_EMAIL_LIMIT=10
FREE_BULK_EMAIL_LIMIT=0
ENABLE_BULK_EMAIL_API=false
PUBLIC_TEMPLATE_PUBLISHING_V2=true
# Flip to true on staging ONLY to test the events flow end-to-end.
NEXT_PUBLIC_EVENTS_ENABLED=false

# Optional alternate email provider
RESEND_API_KEY=resend-staging-key-placeholder

# Operator console (analytics + plan management). Off unless both are set.
# The console page lives at /ops/<ADMIN_CONSOLE_PATH_KEY>; every other address
# answers 404. Generate the key with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Access also requires the serenityAdmin claim (scripts/admin/grant-admin.mjs)
# and the console passphrase (scripts/admin/set-console-passphrase.mjs).
ADMIN_CONSOLE_ENABLED=false
ADMIN_CONSOLE_PATH_KEY=
# Optional second check: comma-separated operator emails.
ADMIN_EMAILS=
# Session length in minutes (5-480) and the console's daily Firestore read budget.
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_DAILY_READ_BUDGET=5000
