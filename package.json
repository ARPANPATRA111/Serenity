{
  "name": "serenity",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:staging-env": "node scripts/check-staging-env.mjs",
    "test": "vitest run --exclude tests/*.rules.test.ts",
    "test:rules": "firebase emulators:exec --project demo-serenity --only \"firestore,storage\" \"vitest run tests/firestore.rules.test.ts tests/storage.rules.test.ts\"",
    "test:all": "pnpm test && pnpm test:rules",
    "emulators": "firebase emulators:start --project demo-serenity",
    "dev:emulator": "node scripts/run-with-emulator-env.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "test:smoke": "node scripts/smoke-routes.mjs",
    "test:e2e": "playwright test",
    "verify:local": "pnpm lint && pnpm test:all && pnpm build && pnpm test:smoke"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "fabric": "5.3.0",
    "file-saver": "^2.0.5",
    "firebase": "^10.12.0",
    "firebase-admin": "^12.1.0",
    "framer-motion": "^12.25.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.378.0",
    "nanoid": "^5.0.7",
    "next": "14.2.35",
    "next-themes": "^0.3.0",
    "nodemailer": "^8.0.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^3.2.0",
    "sib-api-v3-sdk": "^8.5.0",
    "tailwind-merge": "^2.3.0",
    "undici": "6.19.7",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "3.0.4",
    "@playwright/test": "^1.62.0",
    "@types/fabric": "^5.3.7",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "firebase-tools": "13.35.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vitest": "2.1.9"
  }
}
