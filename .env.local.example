# Firebase Configuration
FB_CREDENTIAL=your_api_key
FB_AUTH_DOMAIN=your_project.firebaseapp.com
FB_PROJECT=your_project_id
FB_BUCKET=your_project.appspot.com
FB_SENDER=your_sender_id
FB_APP=your_app_id

# Firebase Admin (Server-side)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Brevo (Sendinblue) Email API
SEND_IN_BLUE_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
EMAIL_SENDER_NAME=Serenity Certificates

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DAILY_IP_SALT=your_random_daily_salt_seed
CERTIFICATE_MEDIA_HOSTS=cdn.yourdomain.com

# Vercel Blob (for media storage)
BLOB_READ_WRITE_TOKEN=your_blob_rw_token

# Rate Limiting
DAILY_EMAIL_LIMIT=100
FREE_BULK_EMAIL_LIMIT=5
PUBLIC_TEMPLATE_PUBLISHING_V2=false

# Feature flags
# Events is complete but staging-unverified; keep disabled until tested.
NEXT_PUBLIC_EVENTS_ENABLED=false

# Operator console (analytics + plan management). Off unless both are set.
# The console page lives at /ops/<ADMIN_CONSOLE_PATH_KEY>; every other address
# answers 404. Generate the key with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Access also requires the serenityAdmin claim (scripts/admin/grant-admin.mjs)
# and the console passphrase (scripts/admin/set-console-passphrase.mjs).
ADMIN_CONSOLE_ENABLED=false
ADMIN_CONSOLE_PATH_KEY=
# Optional second check: comma-separated operator emails.
ADMIN_EMAILS=
# Session length in minutes (5-480) and the console's daily Firestore read budget.
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_DAILY_READ_BUDGET=5000
