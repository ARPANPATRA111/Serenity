rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Browser clients are read-only. All mutations flow through authenticated
    // route handlers using the Admin SDK so ownership and server-authoritative
    // fields are enforced in one place.

    // Templates collection
    match /templates/{templateId} {
      // Public and private template reads flow through API allowlists. Direct
      // document reads would otherwise expose canvas JSON and owner metadata.
      allow read, create, update, delete: if false;
    }

    // Certificates collection
    match /certificates/{certificateId} {
      // Owner-only client reads. Public verification does NOT use the client
      // SDK. It goes through the /api/verify route (Firebase Admin SDK), which
      // bypasses these rules. Previously this was `allow read: if true`, which
      // let anyone dump every certificate's recipient PII via the client SDK.
      allow read: if isOwner(resource.data.userId);
      allow create, update, delete: if false;
    }

    // User media collection
    match /user-media/{mediaId} {
      // Users can read their own media
      allow read: if isOwner(resource.data.userId);
      allow create, update, delete: if false;
    }

    // Users collection
    match /users/{userId} {
      // Profile and plan mutations are server-authoritative. In particular,
      // clients must never be able to grant isPremium or alter usage counters.
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Leads collection (for email capture)
    match /leads/{leadId} {
      // Lead creation is validated and rate-limited by /api/leads/capture.
      allow read, create, update, delete: if false;
    }

    // Optional event context is also API-only. Verification receives a
    // public-safe projection from the server instead of exposing owner fields.
    match /events/{eventId} {
      allow read, create, update, delete: if false;
    }
  }
}
